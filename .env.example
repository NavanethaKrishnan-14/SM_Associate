NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=hello@yourdomain.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google Sheets contact-lead integration
# Use the deployed Google Apps Script Web App URL (do not expose this in NEXT_PUBLIC_*).
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
# Must match the CONTACT_FORM_TOKEN Script Property in the Apps Script.
GOOGLE_SHEETS_WEBHOOK_TOKEN=replace-with-a-long-random-secret
